#!/bin/sh
# Refuse the push if the marketplace is invalid or a test fails. Also run by CI, without stdin.
set -e
cd "$(git rev-parse --show-toplevel)"

# Private words (dev-journal/private-words, shared, and the git-ignored .private-words of the main clone) in the
# pushed commits; nothing to check without them, as in CI. Git passes the remote ($1) and the pushed refs on
# stdin, read first; by hand, no refs.
python3 plugins/core/scripts/private_words.py ${1:+--stdin-refs --remote $1}
# Ticket references in the tracked files, examples excepted (.ticket-refs-ignore).
python3 plugins/core/scripts/ticket_refs.py

CLAUDE="$(command -v claude || true)"
[ -n "$CLAUDE" ] || CLAUDE="$(python3 -c 'import sys; sys.path.insert(0, "scripts"); import install; print(install.find_claude() or "")')"
if [ -n "$CLAUDE" ]; then
  "$CLAUDE" plugin validate .
else
  echo "warning: Claude Code CLI not found, marketplace not validated"
fi

# The tests create their own repositories: they must not inherit the hook's Git environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
python3 -m unittest discover -s tests -q
